# Copia este archivo a `.env` (en esta carpeta o en la raíz del repositorio). El .env NUNCA se sube a Git.

# ── Modelo del agente ────────────────────────────────────────────────
LLM_PROVIDER=fake                 # fake (por defecto: sin red ni costo) | openai | anthropic | local (LM Studio)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=                      # vacío → anthropic: claude-haiku-5-5 · openai: gpt-6-luna
LOCAL_LLM_URL=http://localhost:1235/v1
LOCAL_LLM_MODEL=google/gemma-4-12b-qat

# ── HubSpot (el servidor MCP) ────────────────────────────────────────
HUBSPOT_MODE=fake                 # fake (CRM simulado en memoria) | live (HubSpot real)
HUBSPOT_TOKEN=                    # solo para live: token de una Service Key (o app privada) de una cuenta de PRUEBAS
HUBSPOT_API_VERSION=2026-03       # fecha de la API de HubSpot; "v3" usa la ruta heredada /crm/v3/objects

# ── Transporte HTTP (python mcp_server.py --http) ────────────────────
MCP_HOST=127.0.0.1                # en Docker: 0.0.0.0
MCP_PORT=8000

# ── API y UI ─────────────────────────────────────────────────────────
SESSIONS_DB=data/sessions.db      # SQLite de la API: historial de las sesiones (checkpointer) y tabla de sesiones
# MCP_URL=http://127.0.0.1:8000/mcp   # si se define, la API usa ese servidor MCP por HTTP; si no, lanza uno por stdio
API_URL=http://127.0.0.1:8001     # a dónde llama la UI de Streamlit
