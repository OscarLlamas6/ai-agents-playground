meta {
  name: 06 · Listar sesiones del usuario
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/sessions?user_id={{user_id}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  test("aparecen las dos sesiones", function () {
    const ids = res.body.map(s => s.session_id);
    expect(ids).to.include(bru.getVar("session_id"));
    expect(ids).to.include(bru.getVar("other_session_id"));
  });
}
