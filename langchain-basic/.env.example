# Copia este archivo a `.env` (aquí o en la raíz del repo) y completa lo que uses. El .env NUNCA se sube a Git.

LLM_PROVIDER=openai            # openai (por defecto) | anthropic | local (LM Studio) | fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=                   # solo anthropic/openai. Vacío → claude-haiku-5-5 · gpt-6-luna

# local: LM Studio u otro servidor compatible con OpenAI. Un agente necesita un modelo con soporte de herramientas
# y de tamaño mediano (≈ 12B o más): uno de 3B elige mal las herramientas.
LOCAL_LLM_URL=http://localhost:1235/v1
LOCAL_LLM_MODEL=google/gemma-4-12b-qat
