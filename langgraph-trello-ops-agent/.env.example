# Copia este archivo a `.env` (en esta carpeta o en la raíz del repositorio). El .env NUNCA se sube a Git.
# Sin tocar nada, el agente corre 100 % simulado: modelo falso + Trello en memoria + embeddings falsos.

# ── Modelo del agente ────────────────────────────────────────────────
LLM_PROVIDER=fake                 # fake (por defecto, sin red) | openai | anthropic | local (LM Studio)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=                      # vacío → anthropic: claude-haiku-5-5 · openai: gpt-6-luna
LOCAL_LLM_URL=http://localhost:1235/v1      # LM Studio (u otro servidor compatible con OpenAI)
LOCAL_LLM_MODEL=google/gemma-4-12b-qat      # un modelo de ~12B o más: el de 3B elige mal las herramientas

# ── Embeddings del runbook (RAG) ─────────────────────────────────────
EMBEDDINGS_PROVIDER=fake          # fake (por defecto) | openai | local (LM Studio)
# EMBEDDINGS_MODEL=               # openai: text-embedding-3-small · local: text-embedding-nomic-embed-text-v2-moe

# ── Trello ───────────────────────────────────────────────────────────
TRELLO_MODE=fake                  # fake (por defecto: Trello simulado en memoria) | live (API real)
# Solo para TRELLO_MODE=live. Clave: trello.com/power-ups/admin → tu Power-Up → «API key». Token: se genera con la URL de
# autorización del README (scope read,write). Mínimo privilegio: usa un tablero y una cuenta de PRUEBA.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_WRITE_BOARDS=              # ids de tableros donde se permite escribir, separados por comas. Vacío = escrituras bloqueadas
TRELLO_DRY_RUN=0                  # 1 = valida todo pero NO escribe

# ── Agente ───────────────────────────────────────────────────────────
MAX_STEPS=8                       # tope de llamadas al modelo por pregunta
# OPS_DB=.data/ops.sqlite         # archivo SQLite: conversaciones, preferencias y sesiones de la API sobreviven al reinicio (la API usa .data/ops.sqlite por defecto)
# API_URL=http://127.0.0.1:8011   # dirección de la API que usa la interfaz Streamlit
# API_PORT=8011                   # puertos publicados por docker compose (API y UI)
# UI_PORT=8511

# ── MCP (opcional; ver README) ───────────────────────────────────────
USE_MCP=0                         # 1 = suma herramientas de servidores MCP (requiere `uv sync --group mcp`)
# MCP_SERVERS_FILE=mcp_servers.json
# MCP_READONLY_TOOLS=             # herramientas MCP de solo lectura (el resto pide aprobación)
