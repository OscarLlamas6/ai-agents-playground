meta {
  name: 03 Chat: misma sesión (seguimiento)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: none
}

body:json {
  {
    "message": "Mi tablero por defecto es \"Migración a la nube\"",
    "session_id": "{{session_id}}",
    "user_id": "{{user_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.session_id: eq {{session_id}}
}

tests {
  test("misma sesión, y la preferencia queda en la memoria de largo plazo", function () {
    expect(res.body.tools_used).to.include("remember_preference");
  });
}

docs {
  Con el mismo session_id la conversación continúa. Aquí además se guarda una preferencia en el Store (memoria de largo plazo, por usuario).
}
