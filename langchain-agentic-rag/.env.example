# Copia este archivo a `.env` (en esta carpeta o en la raíz del repositorio). El .env NUNCA se sube a Git.

# ── Modelo del agente ────────────────────────────────────────────────
LLM_PROVIDER=openai               # openai (por defecto) | anthropic | local (LM Studio)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=                      # vacío → anthropic: claude-haiku-5-5 · openai: gpt-6-luna
LOCAL_LLM_URL=http://localhost:1235/v1      # LM Studio (u otro servidor compatible con OpenAI)
LOCAL_LLM_MODEL=google/gemma-4-12b-qat      # un modelo de ~12B o más: el de 3B elige mal las herramientas

# ── Embeddings (convierten texto en vectores) ────────────────────────
EMBEDDINGS_PROVIDER=openai        # openai (por defecto) | local (LM Studio) | fake
EMBEDDINGS_MODEL=text-embedding-3-small
# Con LM Studio: EMBEDDINGS_PROVIDER=local y EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v2-moe

# ── Base de datos (Postgres con pgvector: vectores del manual, bitácora y huecos del manual) ──
# Levántala con: docker compose up -d db
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent
# VECTOR_STORE=memory             # para probar SIN base de datos (todo en RAM; la bitácora se pierde)

# ── API y UI ──
# LLM_PROVIDER=fake                # sin llaves ni red: un modelo de juguete para demos y pruebas (EMBEDDINGS_PROVIDER=fake también)
# API_URL=http://localhost:8000    # dónde está la API (lo lee la interfaz Streamlit)
# AUTO_INGEST=1                    # la API indexa el manual al arrancar si hace falta (sin esto, usa `python cli.py ingest`)
# MEMORY_FILE=state/preferences.json   # solo SIN base de datos: dónde se vuelca la memoria de largo plazo (con DATABASE_URL vive en Postgres)
