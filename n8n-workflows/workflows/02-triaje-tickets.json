    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Resolver decisión').first().json;\nconst ejecutada = $('Ejecutar acción (dry-run)').isExecuted;\nconst estado = ejecutada ? (ctx.dry_run ? 'ejecutada_dry_run' : 'ejecutada') : ctx.aprobacion.estado;\nconst registro = {\n  ticket_id: ctx.ticket.ticket_id, estado, severidad: ctx.severidad_final, categoria: ctx.clasificacion.categoria,\n  modo: ctx.modo, dry_run: ctx.dry_run, accion: ctx.propuesta.accion, aprobacion: ctx.aprobacion,\n  mensaje: `Ticket ${ctx.ticket.ticket_id}: ${estado} (${ctx.propuesta.accion.tipo} → ${ctx.propuesta.accion.objetivo})`,\n  servicios_url: ctx.servicios_url, execution_id: ctx.execution_id };\nreturn [{ json: { registro } }];"
      },
      "id": "ce0ae976-cb37-5e2c-9415-4ca70dfa3c8a",
      "name": "Armar registro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
