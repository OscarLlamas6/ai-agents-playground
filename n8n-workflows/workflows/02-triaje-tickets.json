    {
      "parameters": {
        "jsCode": "const ctx = $('Normalizar propuesta').first().json;\nconst f = $json;\nconst decision = f.Decision ?? null;\nconst estado = decision === 'Aprobar' ? 'aprobada' : decision === 'Rechazar' ? 'rechazada' : 'expirada';   // sin respuesta = no se ejecuta\nreturn [{ json: { ...ctx, aprobacion: { estado, aprobador: String(f.Aprobador ?? '').slice(0, 40), comentario: String(f.Comentario ?? '').slice(0, 300) } } }];"
      },
