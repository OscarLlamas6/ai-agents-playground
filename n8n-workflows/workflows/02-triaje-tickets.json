      "id": "4ec64a13-1006-55c0-a04d-74126c19e2a6",
      "name": "Enriquecer (sub-workflow)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1800,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Regla de negocio determinista (no la decide el modelo): un activo crítico en producción sube la severidad un nivel.\nconst SEV = ['baja', 'media', 'alta', 'critica'];\nconst c = $json.clasificacion;\nlet i = SEV.indexOf(c.severidad);\nconst a = $json.activo;\nconst escalada = Boolean(a && a.criticidad === 'alta' && a.ambiente === 'produccion' && i >= 1 && i < 3);\nif (escalada) i += 1;\nreturn [{ json: { ...$json, severidad_final: SEV[i], escalada_por_activo: escalada } }];"
      },
