      "id": "990b343f-ecfd-5d53-a232-4d9316815df7",
      "name": "Buscar runbook (sub-workflow)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        2700,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const base = $('Calcular prioridad').first().json;\nconst rb = ($json.runbooks ?? [])[0];\nconst s = rb?.accion_sugerida ?? { tipo: 'escalar_a_oncall', objetivo: 'guardia' };\nreturn [{ json: { output: {\n  diagnostico: `[simulado] ${base.clasificacion.resumen}. Runbook ${rb?.id ?? 'ninguno'}: ${rb?.titulo ?? ''}.`,\n  accion: { tipo: s.tipo, objetivo: s.objetivo, justificacion: 'Acción sugerida por el runbook (modo simulado, sin modelo).' },\n  riesgo: base.severidad_final === 'critica' ? 'medio' : 'bajo', runbook_id: rb?.id ?? '' } } }];"
      },
      "id": "feefc3b4-44dd-5a3a-981c-7e4d2e758210",
      "name": "Diagnóstico (simulado)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2920,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Lista blanca en CÓDIGO: aunque el esquema ya limita los valores, nunca ejecutamos algo que no esté aquí.\nconst PERMITIDAS = ['reiniciar_servicio', 'restablecer_acceso', 'escalar_a_oncall', 'ninguna'];\nconst base = $('Calcular prioridad').first().json;\nconst p = $json.output ?? {};\nconst a = p.accion ?? {};\nconst permitida = PERMITIDAS.includes(a.tipo);\nconst accion = { tipo: permitida ? a.tipo : 'escalar_a_oncall', objetivo: String(a.objetivo ?? 'guardia').slice(0, 80),\n                 justificacion: String(a.justificacion ?? '').slice(0, 300) };\nconst propuesta = { diagnostico: String(p.diagnostico ?? '').slice(0, 600), accion, riesgo: p.riesgo ?? 'medio',\n                    runbook_id: p.runbook_id ?? '', accion_fuera_de_lista: !permitida };\nreturn [{ json: { ...base, propuesta } }];"
      },
      "id": "0f85e160-e25a-50b8-b8b3-fe83f6d02457",
      "name": "Normalizar propuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        -40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.servicios_url }}/sim-registro",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo: 'notificacion', canal: 'chat-aprobadores (simulado)', ticket_id: $json.ticket.ticket_id, severidad: $json.severidad_final, mensaje: 'Aprobar acción ' + $json.propuesta.accion.tipo + ' sobre ' + $json.propuesta.accion.objetivo, url_aprobacion: $execution.resumeFormUrl }) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "ccefd1cd-e45b-5f46-8d4e-ed7b3b3e56b5",
      "name": "Avisar aprobación pendiente",
      "type": "n8n-nodes-base.httpRequest",
