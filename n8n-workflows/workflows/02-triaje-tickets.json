    {
      "parameters": {
        "jsCode": "const b = $json.body ?? {};\nconst s = (v) => (typeof v === 'string' ? v.trim() : '');\nconst errores = [];\nconst ticket_id = s(b.ticket_id);\nif (!/^TCK-[A-Z0-9-]{1,20}$/.test(ticket_id)) errores.push('ticket_id inválido (formato TCK-XXXX)');\nconst asunto = s(b.asunto).slice(0, 200);\nconst descripcion = s(b.descripcion).slice(0, 2000);          // límite de tamaño: el texto va al modelo\nif (!asunto) errores.push('asunto requerido');\nif (descripcion.length < 10) errores.push('descripcion requerida (mínimo 10 caracteres)');\nconst host = s(b.host).toLowerCase();\nif (host && !/^[a-z0-9][a-z0-9-]{0,40}$/.test(host)) errores.push('host inválido');\nreturn [{ json: {\n  valido: errores.length === 0, errores,\n  ticket: { ticket_id, asunto, descripcion, host, solicitante: s(b.solicitante).slice(0, 80), canal: s(b.canal) || 'api' },\n  modo: $json.modo, dry_run: $json.dry_run, servicios_url: $json.servicios_url,\n  execution_id: $execution.id } }];"
      },
