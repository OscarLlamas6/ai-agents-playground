      "parameters": {
        "description": "Consulta el estado actual de un servicio de TI. Entrada: nombre del servicio en minúsculas (vpn, correo, erp, wiki).",
        "language": "javaScript",
        "jsCode": "const ESTADOS = {\n  vpn: 'degradado: 0 túneles activos, 38 intentos de conexión fallidos en 5 min',\n  correo: 'operativo con cola de 1200 mensajes',\n  erp: 'lento: 92% de CPU en erp-app-01',\n  wiki: 'operativo',\n};\nconst clave = String(query).toLowerCase().trim();\nreturn ESTADOS[clave] ?? ('sin datos para ' + clave);"
      },
