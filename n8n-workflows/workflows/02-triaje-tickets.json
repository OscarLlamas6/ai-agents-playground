    },
    {
      "parameters": {
        "jsCode": "const ctx = $json;\nconst registro = {\n  ticket_id: ctx.ticket.ticket_id, estado: 'resuelto_automatico', severidad: ctx.severidad_final, categoria: ctx.clasificacion.categoria,\n  modo: ctx.modo, dry_run: ctx.dry_run, accion: { tipo: 'ninguna', objetivo: '', justificacion: 'Severidad baja o media: sin acción sobre sistemas.' },\n  aprobacion: { estado: 'no_requerida' },\n  mensaje: `Ticket ${ctx.ticket.ticket_id}: respuesta estándar enviada al solicitante (categoría ${ctx.clasificacion.categoria}).`,\n  servicios_url: ctx.servicios_url, execution_id: ctx.execution_id };\nreturn [{ json: { registro } }];"
      },
      "id": "2aa89c9c-62dc-50b7-9a9f-9f5983c9f032",
      "name": "Respuesta automática",
