        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"diagnostico\": {\n      \"type\": \"string\"\n    },\n    \"accion\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"tipo\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"reiniciar_servicio\",\n            \"restablecer_acceso\",\n            \"escalar_a_oncall\",\n            \"ninguna\"\n          ]\n        },\n        \"objetivo\": {\n          \"type\": \"string\"\n        },\n        \"justificacion\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"tipo\",\n        \"objetivo\",\n        \"justificacion\"\n      ]\n    },\n    \"riesgo\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"bajo\",\n        \"medio\",\n        \"alto\"\n      ]\n    },\n    \"runbook_id\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"diagnostico\",\n    \"accion\",\n    \"riesgo\"\n  ]\n}",
        "autoFix": false
