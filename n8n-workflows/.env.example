# Copia este archivo a `.env` (se ignora en Git). Nunca subas llaves. Sin comentarios al final de las líneas.

# Cifra las credenciales guardadas en n8n. Si la pierdes o la cambias, las credenciales guardadas dejan de poder leerse.
N8N_ENCRYPTION_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Token que el cliente envía en la cabecera X-API-Key para llamar al webhook de tickets.
N8N_WEBHOOK_TOKEN=cambia-esto-por-un-token-largo

# Solo para los modos con modelo real (el laboratorio corre sin ellas, en modo simulado).
OPENAI_API_KEY=
# Con LM Studio en tu máquina (Linux): OPENAI_API_KEY=lm-studio y OPENAI_BASE_URL=http://host.docker.internal:1235/v1
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
